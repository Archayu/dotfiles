{
    "label": "lock",
    "action": "sh -c '(sleep 0.5s; swaylock)' & disown",
    "text": "Lock",
    "keybind": "l"
}

{
    "label": "logout",
    "action": "loginctl kill-session $XDG_SESSION_ID",
    "text": "Logout",
    "keybind": "e"
}

{
    "label": "suspend",
    "action": "suspend",
    "text": "Suspend",
    "keybind": "u"
}

{
    "label": "shutdown",
    "action": "systemctl poweroff",
    "text": "Shutdown",
    "keybind": "s"
}

{
    "label": "hibernate",
    "action": "systemctl hibernate",
    "text": "Hibernate",
    "keybind": "h"
}

{
    "label": "reboot",
    "action": "systemctl reboot",
    "text": "Reboot",
    "keybind": "r"
}