/* ╭─────────────── ✦ ────────────────╮ */
/*│        ROFI CONFIGURATION         │ */
/* ╰─────────────── ✦ ────────────────╯ */
/*
 * Author    : archayu
 * GitHub    : https://github.com/archayu/dotfiles
 * Config    : Rofi launcher theme
 */

@import "~/.config/rofi/matugen.rasi"
configuration {
    modi:                        "drun";
    show-icons:                  true;
    drun-display-format:         "{name}";
    font:                        "JetBrainsMono NF Bold 11";
    kb-mode-next:                "Alt+Tab";
    kb-mode-previous:            "Alt+Shift+Tab";
    kb-row-up:                   "Up";
    kb-row-down:                 "Down";
    kb-row-left:                 "Left";
    kb-row-right:                "Right";
}

//----- Global Properties -----//
* {
    main-bg:                    var(backgroundAlt);
    main-fg:                     var(foreground);
    select-bg:                  var(primary);
    select-fg:                   var(active);
    border-color:              var(primary);
    search-bg:                   rgba(30, 30, 46, 0.9);
}

//----- Main Window -----//
window {
    enabled:                     true;
    fullscreen:                  false;
    width:                       85%;
    height:                      80%;
    transparency:                "real";
    cursor:                      "default";
    spacing:                     0px;
    padding:                     0px;
    border:                      2px;
    border-radius:               12px;
    border-color:                @border-color;
    background-color:            transparent;
    location:                    center;
}

//----- Main Box -----//
mainbox {
    enabled:                     true;
    children:                    [ "inputbar", "listview" ];
    background-color:            @main-bg;
    border-radius:               12px;
    padding:                     15px;
}

//----- Inputbar (Search) -----//
inputbar {
    enabled:                     true;
    children:                    [ "prompt", "entry" ];
    background-color:            @search-bg;
    text-color:                  @main-fg;
    border-radius:               8px;
    padding:                     12px 16px;
    margin:                      0px 0px 15px 0px;
    border:                      1px;
    border-color:                @border-color;
}

prompt {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @select-bg;
    padding:                     0px 10px 0px 0px;
}

entry {
    enabled:                     true;
    background-color:            transparent;
    text-color:                  @main-fg;
    placeholder:                 "Search wallpapers...";
    placeholder-color:           rgba(251, 241, 199, 0.5);
    cursor:                      text;
}

//----- Listview -----//
listview {
    enabled:                     true;
    columns:                     4;
    lines:                       3;
    spacing:                     15px;
    padding:                     10px;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   true;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    cursor:                      "default";
    background-color:            transparent;
    text-color:                  @main-fg;
}

scrollbar {
    handle-width:                8px;
    handle-color:                @select-bg;
    background-color:            rgba(251, 241, 199, 0.1);
    border-radius:               4px;
    margin:                      0px 0px 0px 5px;
}

//----- Elements -----//
element {
    enabled:                     true;
    orientation:                 vertical;
    spacing:                     8px;
    padding:                     10px;
    border-radius:               12px;
    cursor:                      pointer;
    background-color:            transparent;
    text-color:                  @main-fg;
    border:                      2px;
    border-color:                transparent;
}

element selected.normal {
    background-color:            @select-bg;
    text-color:                  @select-fg;
    border-color:                @select-bg;
}

element-icon {
    size:                        200px;
    cursor:                      inherit;
    border-radius:               8px;
    background-color:            transparent;
    text-color:                  inherit;
}

element-text {
    vertical-align:              0.5;
    horizontal-align:            0.5;
    padding:                     8px;
    cursor:                      inherit;
    background-color:            transparent;
    text-color:                  inherit;
}

//----- Responsive Design -----//
@media(max-width: 1600) {
    listview {
        columns:                 3;
        lines:                   2;
    }
    element-icon {
        size:                    180px;
    }
}

@media(max-width: 1200) {
    listview {
        columns:                 3;
        lines:                   2;
    }
    element-icon {
        size:                    150px;
    }
}