/* ╭─────────────── ✦ ────────────────╮ */
/*│   FIREFOX DYNAMIC COLOR PALETTE  │ */
/* ╰─────────────── ✦ ────────────────╯ */
/*
  * AUTO-GENERATED by Matugen
  * Source: ~/.config/matugen/templates/firefox.css
  * Theme: Catppuccin Mocha + Wallpaper Colors
  * DO NOT EDIT MANUALLY - Changes will be overwritten
  */

:root {
  /* ═══════════════════════════════════ */
  /* PRIMARY COLORS (from wallpaper)    */
  /* ═══════════════════════════════════ */
  
  --color-primary: #f38ba8;          /* Accent color from wallpaper */
  --color-secondary: #cba6f7;        /* Secondary accent */
  --color-accent: #f9e2af;           /* Highlight accent */
  
  /* ═══════════════════════════════════ */
  /* CATPPUCCIN MOCHA PALETTE           */
  /* ═══════════════════════════════════ */
  
  /* Reds */
  --color-red: #f38ba8;
  --color-maroon: #eba0ac;
  
  /* Peach & Yellow */
  --color-peach: #fab387;
  --color-yellow: #f9e2af;
  
  /* Greens */
  --color-green: #a6e3a1;
  --color-teal: #94e2d5;
  
  /* Blues & Purples */
  --color-sky: #89dceb;
  --color-sapphire: #74c7ec;
  --color-blue: #89b4fa;
  --color-lavender: #b4befe;
  --color-mauve: #cba6f7;
  --color-pink: #f5c2e7;
  --color-flamingo: #f2cdcd;
  --color-rosewater: #f5e0dc;
  
  /* ═══════════════════════════════════ */
  /* NEUTRAL PALETTE                    */
  /* ═══════════════════════════════════ */
  
  --color-text: #cdd6f4;             /* Primary text */
  --color-subtext1: #bac2de;         /* Secondary text */
  --color-subtext0: #a6adc8;         /* Tertiary text */
  
  --color-overlay2: #9399b2;         /* Hover state */
  --color-overlay1: #7f849c;         /* Border light */
  --color-overlay0: #6c7086;         /* Border */
  
  --color-surface2: #585b70;         /* Element backgrounds */
  --color-surface1: #45475a;         /* Component backgrounds */
  --color-surface0: #313244;         /* Panel backgrounds */
  
  --color-base: #1e1e2e;             /* Main background */
  --color-mantle: #181825;           /* Secondary background */
  --color-crust: #11111b;            /* Tertiary background */
}

/* Apply to Firefox UI */
* {
  --moz-appearance: none !important;
}
