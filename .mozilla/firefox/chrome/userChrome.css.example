/* ╭─────────────── ✦ ────────────────╮ */
/*│   FIREFOX UI CHROME STYLING      │ */
/* ╰─────────────── ✦ ────────────────╯ */
/*
  * This file themes the Firefox browser UI (tabs, toolbar, etc.)
  * 
  * Generated by Matugen + Custom Additions
  * Theme: Catppuccin Mocha with dynamic wallpaper colors
  */

@import url("colors.css");

/* ═══════════════════════════════════ */
/* NAV BAR & TOOLBAR                  */
/* ═══════════════════════════════════ */

#nav-bar {
  background-color: var(--color-surface0) !important;
  border-bottom: 1px solid var(--color-overlay0) !important;
}

#urlbar {
  background-color: var(--color-surface1) !important;
  color: var(--color-text) !important;
  border: 1px solid var(--color-overlay1) !important;
  border-radius: 8px !important;
}

#urlbar:hover {
  background-color: var(--color-surface2) !important;
}

/* ═══════════════════════════════════ */
/* TABS STYLING                        */
/* ═══════════════════════════════════ */

.tab-background {
  background-color: var(--color-surface1) !important;
}

.tab-background[selected="true"] {
  background-color: var(--color-surface2) !important;
  color: var(--color-text) !important;
}

.tabbrowser-tab:hover .tab-background:not([selected="true"]) {
  background-color: var(--color-surface2) !important;
}

/* ═══════════════════════════════════ */
/* SIDEBAR & MENUS                     */
/* ═══════════════════════════════════ */

#sidebar-box {
  background-color: var(--color-base) !important;
  color: var(--color-text) !important;
}

menupopup,
panel {
  --panel-background: var(--color-surface0) !important;
  --panel-color: var(--color-text) !important;
  --panel-border-color: var(--color-overlay0) !important;
}

/* ═══════════════════════════════════ */
/* BUTTONS & CONTROLS                  */
/* ═══════════════════════════════════ */

button,
.button {
  background-color: var(--color-surface1) !important;
  color: var(--color-text) !important;
  border: 1px solid var(--color-overlay1) !important;
  border-radius: 6px !important;
}

button:hover,
.button:hover {
  background-color: var(--color-surface2) !important;
}

button:active,
.button:active {
  background-color: var(--color-red) !important;
  color: var(--color-base) !important;
}

/* ═══════════════════════════════════ */
/* SCROLLBAR                           */
/* ═══════════════════════════════════ */

scrollbar {
  background-color: var(--color-surface0) !important;
}

scrollbar thumb {
  background-color: var(--color-overlay1) !important;
  border-radius: 10px !important;
}

scrollbar thumb:hover {
  background-color: var(--color-overlay2) !important;
}

/* ═══════════════════════════════════ */
/* SEARCH BAR                          */
/* ═══════════════════════════════════ */

#searchbar {
  background-color: var(--color-surface1) !important;
  color: var(--color-text) !important;
}

#searchbar:hover {
  background-color: var(--color-surface2) !important;
}
