/* ╭─────────────── ✦ ────────────────╮ */
/*│   FIREFOX WEB CONTENT STYLING    │ */
/* ╰─────────────── ✦ ────────────────╯ */
/*
  * This file themes web content displayed in Firefox
  * 
  * Generated by Matugen + Custom Additions
  * Theme: Catppuccin Mocha with dynamic wallpaper colors
  */

@import url("colors.css");
@import url("websites/index.css");

/* ═══════════════════════════════════ */
/* SCROLL BAR                          */
/* ═══════════════════════════════════ */

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: var(--color-base);
}

::-webkit-scrollbar-thumb {
  background: var(--color-overlay1);
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--color-overlay2);
}

/* ═══════════════════════════════════ */
/* FORM ELEMENTS                       */
/* ═══════════════════════════════════ */

input,
textarea,
select {
  background-color: var(--color-surface0) !important;
  color: var(--color-text) !important;
  border: 1px solid var(--color-overlay1) !important;
  border-radius: 6px !important;
  padding: 8px !important;
}

input:focus,
textarea:focus,
select:focus {
  background-color: var(--color-surface1) !important;
  border-color: var(--color-red) !important;
  outline: none !important;
}

button {
  background-color: var(--color-surface1) !important;
  color: var(--color-text) !important;
  border: 1px solid var(--color-overlay1) !important;
  border-radius: 6px !important;
  cursor: pointer !important;
}

button:hover {
  background-color: var(--color-surface2) !important;
}

button:active {
  background-color: var(--color-red) !important;
  color: var(--color-base) !important;
}

/* ═══════════════════════════════════ */
/* CODE BLOCKS                         */
/* ═══════════════════════════════════ */

code,
pre {
  background-color: var(--color-surface0) !important;
  color: var(--color-green) !important;
  border-left: 3px solid var(--color-red) !important;
  padding: 8px !important;
  border-radius: 4px !important;
}

/* ═══════════════════════════════════ */
/* LINKS                               */
/* ═══════════════════════════════════ */

a {
  color: var(--color-blue) !important;
}

a:visited {
  color: var(--color-mauve) !important;
}

a:hover {
  color: var(--color-red) !important;
}

/* ═══════════════════════════════════ */
/* SELECTION                           */
/* ═══════════════════════════════════ */

::selection {
  background-color: var(--color-red) !important;
  color: var(--color-base) !important;
}

::-moz-selection {
  background-color: var(--color-red) !important;
  color: var(--color-base) !important;
}

/* ═══════════════════════════════════ */
/* CODE SYNTAX HIGHLIGHTING           */
/* ═══════════════════════════════════ */

.hljs {
  background-color: var(--color-surface0) !important;
  color: var(--color-text) !important;
}

.hljs-string { color: var(--color-green) !important; }
.hljs-number { color: var(--color-yellow) !important; }
.hljs-literal { color: var(--color-blue) !important; }
.hljs-attr { color: var(--color-pink) !important; }
.hljs-function { color: var(--color-blue) !important; }
.hljs-title { color: var(--color-red) !important; }
.hljs-params { color: var(--color-text) !important; }
